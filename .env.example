# Weave — development environment
#
#   cp .env.example .env
#   make up-build
#
# This file is read by docker-compose.yml (development only).
# For a real server, start from .env.production.example instead.
#
# Two things to know before editing:
#
# 1. Only the variables in the first section have any effect in development.
#    The dev compose file hard-codes the database credentials, DEBUG, LOG_LEVEL
#    and NEXT_PUBLIC_API_URL so the stack works out of the box (see the last
#    section).
#
# 2. After changing this file, run `make up` — not `make restart`.
#    `restart` reuses the existing containers and does not re-read .env.

COMPOSE_PROJECT_NAME=weave

# Ports on your machine. Change them if something else is already listening.
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432

# Key used to encrypt secrets stored in the database (SMTP password, AI API key).
# Optional in development — a dev-only default is used when empty.
# Generate: openssl rand -hex 32
ENCRYPT_KEY=

# Web Push (VAPID) — optional. In-app notifications work without it; only
# background push (browser closed) needs these.
# Generate: make generate-vapid   (paste the output here, then run `make up`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# GitHub App — optional. Moves task status when linked pull requests are
# opened, merged or closed. Leave all three empty to keep it off.
# Setup steps: README → "GitHub App Integration".
# GITHUB_APP_PRIVATE_KEY is the PEM file encoded as a single base64 line:
#   Linux: base64 -w0 app.private-key.pem
#   macOS: base64 -i app.private-key.pem | tr -d '\n'
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Not read by the development compose file (hard-coded there).
# Listed so you know they exist; set them in .env.production on a server.
# ---------------------------------------------------------------------------
# POSTGRES_USER=weave
# POSTGRES_PASSWORD=weave
# POSTGRES_DB=weave
# DATABASE_URL=postgresql+asyncpg://weave:weave@db:5432/weave
# DEBUG=true
# LOG_LEVEL=DEBUG
# NEXT_PUBLIC_API_URL=http://localhost:8000
