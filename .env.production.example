# Weave — Production Environment
# Copy this file to .env.production and fill in your values:
#   cp .env.production.example .env.production
#
# Used by: make prod, make prod-build, etc.

COMPOSE_PROJECT_NAME=weave

# 단일 노출 포트 (외부 nginx/리버스 프록시 -> 이 포트)
EXPOSE_PORT=13000

# Database (강력한 비밀번호 사용! 기본 'weave:weave'면 운영에서 backend 시작 거부됨)
POSTGRES_USER=weave
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD
POSTGRES_DB=weave
# 아래 비밀번호는 POSTGRES_PASSWORD와 반드시 동일하게
DATABASE_URL=postgresql+asyncpg://weave:CHANGE_ME_TO_STRONG_RANDOM_PASSWORD@db:5432/weave

# Backend
LOG_LEVEL=WARNING
DEBUG=false
ALLOWED_ORIGINS=https://weave.example.com
# 신뢰 프록시 대역 (선택). 기본값은 루프백 + docker 브리지(172.16.0.0/12)라 같은 스택의 nginx만
# 신뢰한다. docker 기본 주소풀이 아니거나 backend를 직접 노출하면 실제 nginx 대역/IP로 좁혀서 명시.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
# 필수! 미설정 시 backend 시작 실패 — openssl rand -hex 32 로 생성
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_HEX_64

# Encryption (SMTP 비밀번호 등 민감 데이터 암호화)
# 필수! 미설정 시 backend 시작 실패 — openssl rand -hex 32 로 생성
ENCRYPT_KEY=CHANGE_ME_TO_RANDOM_HEX_64

# Web Push (VAPID, 선택) — make prod-generate-vapid 로 생성한 뒤 make prod
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# GitHub App 연동 (선택 — PR 기반 태스크 자동 전환).
# 사용하지 않으려면 GITHUB_APP_ID/GITHUB_APP_PRIVATE_KEY/GITHUB_WEBHOOK_SECRET을 모두 비운다.
# 사용하려면 Webhook URL을 https://<your-host>/api/github/webhook 로 설정하고,
# 권한 Metadata:read, Pull requests:read, Contents:read / 이벤트 Pull request를 켠다.
# GITHUB_APP_PRIVATE_KEY는 base64(PEM) 단일행:
#   Linux: base64 -w0 app.private-key.pem
#   macOS: base64 -i app.private-key.pem | tr -d '\n'
# CHANGE_ME 같은 placeholder 값을 넣으면 production 시작 시 의도적으로 실패한다.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Frontend (브라우저에서 API 호출 시 사용되는 URL)
# 프로덕션: 동일 도메인 사용 (컨테이너 nginx가 /api를 backend로 라우팅)
NEXT_PUBLIC_API_URL=https://weave.example.com
